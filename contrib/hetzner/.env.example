# Copy to .env, chmod 600, and replace every placeholder.
# Shared HMAC secret used only between Lore Server and the private Cloudflare Worker.
# Generate at least 32 random bytes and install the same value with:
#   wrangler secret put AUTH_SECRET_ACCESS_KEY --env staging
LORE_CLOUDFLARE_SHARED_SECRET=replace-with-a-long-random-secret

# Change this to a fresh empty directory for each cold-server-cache pass.
LORE_CACHE_ROOT=/var/lib/lore/cache
