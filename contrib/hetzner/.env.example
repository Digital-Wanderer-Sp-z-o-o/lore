# Copy to .env, chmod 600, and replace every placeholder.
# This file is staging-only while the DynamoDB-compatible D1 gateway remains.

R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
AWS_ACCESS_KEY_ID=archigma-lore-staging
AWS_SECRET_ACCESS_KEY=replace-with-the-worker-auth-secret

# Change this to a fresh empty directory for each cold-server-cache pass.
LORE_CACHE_ROOT=/var/lib/lore/cache
